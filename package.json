{
  "name": "tianmeng-continent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "《天梦大陆》——单人、浏览器运行、文字叙事驱动的 D20 奇幻 CRPG",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:r3": "node qa/r3-e2e.mjs",
    "qa:prod": "node qa/prod-smoke.mjs",
    "qa:cloud": "node qa/p2-005-cloud-e2e.mjs",
    "qa:worker": "node qa/p2-005-worker-e2e.mjs",
    "qa:p2-005-worker": "npm run qa:worker",
    "qa:p2-005-layout": "node qa/p2-005-layout-e2e.mjs",
    "qa:p2-005-combat-layout": "node qa/p2-005-combat-layout-e2e.mjs",
    "qa:p2-005-merchant": "node qa/p2-005-merchant-e2e.mjs",
    "qa:p2-004": "node qa/p2-004-e2e.mjs && node qa/p2-004-r1-e2e.mjs",
    "qa:p2-006-game-ui": "node qa/p2-006-game-ui-e2e.mjs",
    "qa:p2-006-combat-ui": "node qa/p2-006-combat-ui-e2e.mjs",
    "qa:p2-006-balance": "node qa/p2-006-balance.mjs --phase after",
    "qa:p2-006": "npm run qa:p2-006-game-ui && npm run qa:p2-006-combat-ui && npm run qa:p2-006-balance",
    "qa:rc": "npm run build && node qa/rc-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.6",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.125.0"
  }
}
